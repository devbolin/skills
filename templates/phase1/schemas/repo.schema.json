{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/repo.schema.json",
  "title": "Skill Repository Manifest",
  "type": "object",
  "required": ["repo_id", "name", "owners", "skills"],
  "additionalProperties": false,
  "properties": {
    "repo_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "visibility": { "type": "string", "enum": ["internal", "private", "public"] },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^skills/[a-z0-9-]+$" }
        }
      }
    }
  }
}
